# =============================================================================
# Sahayak AI — example environment configuration.
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# ---- Application ----
APP_ENV=development
APP_NAME=Sahayak AI
LOG_LEVEL=INFO
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- LLM provider ----
# One of: azure_foundry | openai_compatible | ollama | mock
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60
LLM_RETRY_COUNT=2

# ---- Microsoft Foundry ----
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL=
AZURE_TENANT_ID=

# ---- OpenAI-compatible hosted models ----
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Ollama (optional local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./sahayak.db

# ---- Embeddings ----
# One of: azure_foundry | openai_compatible | mock
EMBEDDING_PROVIDER=mock
AZURE_AI_EMBEDDING_MODEL=

# ---- Vector store ----
# One of: memory | chroma
VECTOR_STORE=memory
CHROMA_PERSIST_DIRECTORY=./data/vector_store

# ---- Government web search ----
# One of: tavily | none
SEARCH_PROVIDER=none
TAVILY_API_KEY=

# ---- Speech (optional) ----
# One of: azure_speech | none
SPEECH_PROVIDER=none
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- File uploads ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
# JSON list of allowed upload MIME types
ALLOWED_UPLOAD_MIMETYPES=["application/pdf","image/png","image/jpeg","text/plain","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

# ---- Auth ----
# One of: none | oidc
AUTH_PROVIDER=none
OIDC_ISSUER=
OIDC_AUDIENCE=
# Dev-only isolated identity (NEVER use in production)
DEV_USER_ID=dev-user
